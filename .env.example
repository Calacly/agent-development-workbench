# Backend Configuration
DATABASE_URL=sqlite:mcp_client.db
PORT=33000
# Address to listen on. 127.0.0.1 = this machine only, 0.0.0.0 = reachable from the network
HOST=127.0.0.1
JWT_SECRET=change_this_to_a_secure_random_string_min_32_characters
JWT_EXPIRATION_HOURS=24
ENCRYPTION_KEY=change-me-in-production-32chars-exactly

# Development
RUST_LOG=debug
